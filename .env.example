# ==============================================================================
# SAJI (Sajian Healthy Bowl) — Environment Configuration Template
# NOTE: Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or `.env.production` containing real secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER SETTINGS (Server-Side Only)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SESSION MANAGEMENT (Confidential)
# ------------------------------------------------------------------------------
# Default admin username for managing orders and viewing audit logs
ADMIN_USERNAME=CHANGE_ME_ADMIN_USERNAME

# Admin password hash or raw secret for initialization (Change in production!)
# In production, use a high-entropy passphrase or pre-hashed argon2id/bcrypt string
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Cryptographic secret used for signing session cookies (Minimum 32 random chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_64_HEX_CHAR_RANDOM_SESSION_SECRET

# Session validity duration in milliseconds (Default: 3600000 = 1 hour)
SESSION_MAX_AGE_MS=3600000

# ------------------------------------------------------------------------------
# 3. RATE LIMITING ENGINE (Server-Side Protection)
# ------------------------------------------------------------------------------
# Form submission: Max 5 submissions per 10 minutes per IP
RATE_LIMIT_FORM_WINDOW_MS=600000
RATE_LIMIT_FORM_MAX=5

# Admin Login: Max 5 failed attempts per 15 minutes per IP
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# General Static/API requests per IP per minute
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=120

# ------------------------------------------------------------------------------
# 4. BOT PROTECTION & ANTI-SPAM (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# PUBLIC Site Key (Can be safely exposed in frontend HTML / JS)
# Obtain from Cloudflare Dashboard -> Turnstile -> Add Site
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx

# PRIVATE Secret Key (Strictly Server-Side for server verification, NEVER EXPOSE!)
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# 5. WHATSAPP & CONTACT NOTIFICATIONS (Public / Client Configuration)
# ------------------------------------------------------------------------------
# Official WhatsApp business phone number in international format (+62 / 62)
NEXT_PUBLIC_WA_PHONE=62811423799
OFFICIAL_CONTACT_EMAIL=halo@sajibowl.id
DPO_PRIVACY_EMAIL=privasi@sajibowl.id

# ------------------------------------------------------------------------------
# 6. ERROR TRACKING & REAL-TIME ALERTING (Sentry SDK & Webhooks)
# ------------------------------------------------------------------------------
# Public DSN for client-side browser error monitoring
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000

# Private DSN for server-side runtime unhandled exceptions
SENTRY_DSN=https://examplePublicKey@o000000.ingest.sentry.io/0000000

# Performance sample rate (0.1 = 10% to preserve free-tier quota)
SENTRY_TRACES_SAMPLE_RATE=0.1

# Real-time incident notification webhook (Slack / Discord / Teams / Telegram)
ALERT_WEBHOOK_URL=CHANGE_ME_ALERT_WEBHOOK_URL

# ------------------------------------------------------------------------------
# 7. AUTOMATED DATABASE BACKUP & RESTORE ENCRYPTION
# ------------------------------------------------------------------------------
# 256-bit AES-256-GCM encryption secret for database snapshots at rest
# Generate high entropy key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHAR_RANDOM_BACKUP_KEY

# Rolling backup retention in days (Expired archives auto-pruned)
BACKUP_RETENTION_DAYS=30

